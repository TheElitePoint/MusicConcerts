# --- Free, keyless sources need nothing: MusicBrainz, Wikidata, Deezer, iTunes, Bandcamp ---

# Spotify (free client-credentials; https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Discogs personal access token (free, instant; https://www.discogs.com/settings/developers)
DISCOGS_TOKEN=

# Groq - classification + review pre-adjudication + narrative generation
GROQ_API_KEY=

# Apify - PEOPLE/PROFILE RESOLUTION ONLY. Never used for company discovery.
APIFY_TOKEN=

# Tavily - OPPORTUNISTIC SECOND LAYER ONLY. Pipeline must work fully without it.
TAVILY_API_KEY=

# Contact email embedded in the User-Agent (required by MusicBrainz API policy)
MB_CONTACT_EMAIL=
